{% set howCount = howApps | length %}
<section id="how" class="kb-section" data-pad="1" style="background:var(--bg-surface);border-top:1px solid var(--border-subtle)">
<div class="kb-container" style="margin-bottom:var(--space-8);text-align:center">
<span data-reveal="1" data-how-eyebrow="1" style="display:inline-block;font-family:var(--font-mono);font-size:11px;font-weight:500;text-transform:uppercase;letter-spacing:0.08em;color:{{ howApps[0].color }};transition:color 180ms cubic-bezier(0.4,0,0.2,1)">How it works</span>
</div>
{% for app in howApps %}
{% set nextApp = howApps[(loop.index0 + 1) % howCount] %}
<div class="how-panel" data-how-panel="{{ app.key }}" data-how-color="{{ app.color }}"{% if not loop.first %} hidden{% endif %} style="--fg-brand:{{ app.color }};--bg-brand-subtle:{{ app.subtle }}">
<div class="how-head">
<div class="how-nav-side">
<button class="how-arrow" data-how-prev="1" aria-label="Previous app"><i class="ph ph-arrow-left"></i></button>
<span class="how-side-spacer" aria-hidden="true"></span>
</div>
<h2 class="how-headline" style="font-family:var(--font-display);font-size:clamp(28px,4vw,40px);line-height:1.2;letter-spacing:-0.025em;font-weight:600;color:var(--fg-1);text-wrap:balance">{% if app.hlWord %}{{ app.before }}{{ hWord(app.hlWord, app.hlIcon) }}{{ app.after }}{% else %}{{ app.heading }}{% endif %}</h2>
<div class="how-nav-side">
<span class="how-next-icon" style="background:{{ nextApp.color }}" aria-hidden="true"><i class="{{ nextApp.icon }}"></i></span>
<button class="how-arrow" data-how-next="1" aria-label="Next app: {{ nextApp.name }}"><i class="ph ph-arrow-right"></i></button>
</div>
</div>
<div class="kb-container">
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:var(--space-4)">
{% for step in app.steps %}<div>{{ stepCard(step.num, step.title, step.body, step.icon) }}</div>{% endfor %}
</div>
</div>
</div>
{% endfor %}
</section>

<section id="pricing" class="kb-section" data-pad="1" style="border-top:1px solid var(--border-subtle)">
<div class="kb-container">
<div data-reveal="1" class="kb-section-head" style="max-width:680px">
<span style="display:inline-block;font-family:var(--font-mono);font-size:11px;font-weight:500;text-transform:uppercase;letter-spacing:0.08em;color:var(--fg-brand);margin-bottom:var(--space-3)">Pricing</span>
<h2 style="font-family:var(--font-display);font-size:clamp(28px,4vw,40px);line-height:1.2;letter-spacing:-0.025em;font-weight:600;margin:0;text-wrap:balance">One platform fee.<br>Add the apps you need.</h2>
</div>
{% set teaserPoints = {
  "costing": ["Invoice Inbox and Auto-Match", "Labor costing from payroll", "Data Integrity lists"],
  "follow-up": ["A cadence for every unsold estimate", "Drafts written overnight in your voice", "Sends from your own Gmail and phone"],
  "warehouse": ["Unlimited floor staff accounts", "Manifest import and scan receiving", "Job readiness and pick routes"]
} %}
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:var(--space-4);align-items:start">
{% for a in pricing.apps %}
{%- set prod = products[a.slug] %}
{%- set seatWord = a.seat if a.includedSeats == 1 else a.seats %}
<div data-reveal="1"{% if not loop.first %} data-delay="{{ loop.index0 * 80 }}"{% endif %} style="height:100%">{{ pricingTier(prod.name, a.monthly | usd | replace("$", ""), [a.includedSeats + " " + seatWord + " included", (a.seatMonthly | usd) + " per extra " + a.seat + " a month"].concat(teaserPoints[a.slug]), "", prod.tagline) }}</div>
{% endfor %}
</div>
<p data-reveal="1" style="font-size:15px;color:var(--fg-2);text-align:center;max-width:640px;margin:var(--space-8) auto 0;line-height:1.55">Every account adds the {{ pricing.platform.monthly | usd }}/mo platform fee, {{ pricing.platform.waiver | lower }}. {{ pricing.annualNote }}</p>
<div data-reveal="1" style="display:flex;justify-content:center;gap:var(--space-3);margin-top:var(--space-6);flex-wrap:wrap">
{{ button("Book a Demo", demoUrl, "primary", "md") }}
{{ button("See Full Pricing", "/pricing/", "secondary", "md") }}
</div>
</div>
</section>

<section id="faq" class="kb-section" data-pad="1" style="background:var(--bg-surface);border-top:1px solid var(--border-subtle)">
<div class="kb-container kb-container--narrow">
<div data-reveal="1" class="kb-section-head" style="margin-bottom:var(--space-10)">
<span style="display:inline-block;font-family:var(--font-mono);font-size:11px;font-weight:500;text-transform:uppercase;letter-spacing:0.08em;color:var(--fg-brand);margin-bottom:var(--space-3)">Frequently Asked Questions</span>
<h2 style="font-family:var(--font-display);font-size:clamp(28px,4vw,40px);line-height:1.2;letter-spacing:-0.025em;font-weight:600;margin:0">The things owners ask first.</h2>
</div>
{% set priceAnswer %}Every account pays a {{ pricing.platform.monthly | usd }}/mo platform fee, {{ pricing.platform.waiver | lower }}. {% for a in pricing.apps %}{{ products[a.slug].name }} is {{ a.monthly | usd }}/mo with {{ a.includedSeats }} {{ a.seat if a.includedSeats == 1 else a.seats }} included, plus {{ a.seatMonthly | usd }} a month for each extra {{ a.seat }}. {% endfor %}{{ pricing.annualNote }}{% endset %}
{% set faqs = [
  { "id": "account", "q": "How do I get an account?", "a": "Book a demo. Our team sets up every Kickback account: we create your organization, invite you as the owner, and connect your CRM and supplier accounts with you on the call." },
  { "id": "price", "q": "What does it cost?", "a": priceAnswer | trim },
  { "id": "crm", "q": "Which CRM do you work with?", "a": "Your CRM stays the source of truth. We connect to it, we don't replace it. Tell us which one you use on a demo call and we'll show you what works with it today." },
  { "id": "behind", "q": "We're months behind on job costing. Is that a problem?", "a": "It's the normal case. We backfill the pile during onboarding — get caught up in under an hour, or your first month is free." },
  { "id": "autopost", "q": "Does the AI post things without me?", "a": "Nothing goes to a customer without your approval. Follow-Up drafts each message and you send it. In Costing, Auto-Match links an invoice to its job only when the match is clear, and a person confirms the cost lines before they're written to your CRM." },
  { "id": "leave", "q": "What happens to my data if we leave?", "a": "Costs live in your CRM, not ours. That's the point of writing back. Export the raw invoice records any time, and we delete on request." }
] %}
{% include "partials/faq-list.njk" %}
</div>
</section>

