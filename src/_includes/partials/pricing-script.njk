<script>
(function () {
  // Prices come from data attributes rendered from src/_data/pricing.json.
  var builder = document.getElementById('builder');
  if (!builder) return;

  var platform = {
    monthly: Number(builder.dataset.platformMonthly),
    annual: Number(builder.dataset.platformAnnual)
  };
  var seatCap = Number(builder.dataset.seatCap);
  var rows = Array.prototype.slice.call(builder.querySelectorAll('[data-app]'));
  var apps = rows.map(function (row) {
    var d = row.dataset;
    return {
      row: row,
      slug: d.app,
      monthly: Number(d.monthly),
      annual: Number(d.annual),
      included: Number(d.included),
      seatMonthly: Number(d.seatMonthly),
      seatAnnual: Number(d.seatAnnual),
      seat: d.seat,
      seats: Number(d.included),
      box: row.querySelector('input[type="checkbox"]')
    };
  });

  var total = document.getElementById('builder-total');
  var per = document.getElementById('builder-per');
  var platformPrice = document.getElementById('platform-price');
  var note = document.getElementById('builder-note');
  var noteIcon = document.getElementById('builder-note-icon');
  var noteText = document.getElementById('builder-note-text');
  var fmt = function (n) { return '$' + n.toLocaleString('en-US'); };

  function period() {
    var picked = builder.querySelector('input[name="billing"]:checked');
    return picked && picked.value === 'annual' ? 'annual' : 'monthly';
  }

  function appPrice(app, p) {
    var base = p === 'annual' ? app.annual : app.monthly;
    var seat = p === 'annual' ? app.seatAnnual : app.seatMonthly;
    return base + Math.max(0, app.seats - app.included) * seat;
  }

  function paint() {
    var p = period();
    var unit = p === 'annual' ? '/yr' : '/mo';
    var on = apps.filter(function (a) { return a.box.checked; });
    var waived = on.length === apps.length;
    var fee = p === 'annual' ? platform.annual : platform.monthly;
    var sum = on.reduce(function (acc, a) { return acc + appPrice(a, p); }, 0);

    total.textContent = ((waived ? 0 : fee) + sum).toLocaleString('en-US');
    per.textContent = unit;
    platformPrice.textContent = fmt(fee) + unit;
    platformPrice.classList.toggle('is-waived', waived);
    note.classList.toggle('is-prompt', !waived);
    noteIcon.className = waived ? 'ph-fill ph-check' : 'ph ph-piggy-bank';
    noteText.textContent = waived
      ? 'All three apps added. The platform fee is waived.'
      : 'Add all three apps and the ' + fmt(fee) + unit + ' platform fee is waived.';

    apps.forEach(function (a) {
      var seatPrice = p === 'annual' ? a.seatAnnual : a.seatMonthly;
      document.getElementById('seats-' + a.slug).textContent = String(a.seats);
      document.getElementById('hint-' + a.slug).textContent =
        a.included + ' included \u00b7 ' + fmt(seatPrice) + '/' + a.seat + unit + ' after' +
        (a.seats >= seatCap ? ' \u00b7 ' + seatCap + ' max' : '');
      document.getElementById('price-' + a.slug).textContent = '+' + fmt(appPrice(a, p)) + unit;
      // At least one app is required, so the last checked box can't be cleared.
      a.box.disabled = on.length === 1 && a.box.checked;
      a.row.classList.toggle('is-on', a.box.checked);
    });
  }

  apps.forEach(function (a) { a.box.addEventListener('change', paint); });
  builder.querySelectorAll('input[name="billing"]').forEach(function (r) {
    r.addEventListener('change', paint);
  });
  builder.querySelectorAll('button[data-seats-for]').forEach(function (btn) {
    btn.addEventListener('click', function (e) {
      e.preventDefault();
      var app = apps.filter(function (a) { return a.slug === btn.dataset.seatsFor; })[0];
      app.seats = Math.min(seatCap, Math.max(app.included, app.seats + Number(btn.dataset.dir)));
      paint();
    });
  });
  paint();
})();
</script>
