{#- /pricing. Every amount comes from src/_data/pricing.json; the package
    builder script (partials/pricing-script.njk) reads the same numbers from
    the data attributes below. -#}
<section id="pricing" class="section section-tinted">
  <div class="container">
    <div class="section-head reveal-group">
      <div class="ks-eyebrow reveal">PRICING</div>
      <h1 class="ks-h1 reveal">One Platform Fee. Add the Apps You Need.</h1>
      <p class="ks-lede reveal">Every account runs on the Kickback platform: one login, your tools connected once, shared by every app. Add Costing, Follow-Up, Warehouse or any mix. Subscribe to all three and the platform fee is waived.</p>
    </div>

    <div class="pricing-grid pricing-grid-builder reveal-group">

      <div class="tier tier-hi reveal" id="builder"
        data-platform-monthly="{{ pricing.platform.monthly }}"
        data-platform-annual="{{ pricing.platform.annual }}"
        data-seat-cap="{{ pricing.seatCap }}">
        <div class="tier-tag">BUILD YOUR PACKAGE</div>
        <div class="tier-name">Kickback Platform</div>

        <fieldset class="builder-billing">
          <legend class="visually-hidden">Billing period</legend>
          <label><input type="radio" name="billing" value="monthly" checked><span>Monthly</span></label>
          <label><input type="radio" name="billing" value="annual"><span>Annual <em>2 Months Free</em></span></label>
        </fieldset>

        <label class="builder-row is-locked is-on" style="--row-accent: var(--red-500)">
          <input type="checkbox" checked disabled aria-label="Kickback Platform (required)">
          <span class="builder-mark" style="background: var(--red-500)"><i class="ph-fill ph-database" aria-hidden="true"></i></span>
          <span class="builder-copy">
            <span class="builder-name">Platform <span class="ks-badge">REQUIRED</span></span>
            <p class="builder-desc">One login for your team, roles for each app, the Audit Log, and your CRM and supplier accounts connected once. {{ pricing.platform.waiver }}.</p>
          </span>
          <span class="builder-price" id="platform-price">{{ pricing.platform.monthly | usd }}/mo</span>
        </label>

        {% for a in pricing.apps %}
        {%- set prod = products[a.slug] %}
        <label class="builder-row is-on" style="--row-accent: {{ prod.color }}"
          data-app="{{ a.slug }}" data-monthly="{{ a.monthly }}" data-annual="{{ a.annual }}"
          data-included="{{ a.includedSeats }}" data-seat-monthly="{{ a.seatMonthly }}" data-seat-annual="{{ a.seatAnnual }}"
          data-seat="{{ a.seat }}" data-seats="{{ a.seats }}">
          <input type="checkbox" id="opt-{{ a.slug }}" checked aria-label="Add {{ prod.name }}">
          <span class="builder-mark" style="background: {{ prod.color }}"><i class="{{ prod.icon }}" aria-hidden="true"></i></span>
          <span class="builder-copy">
            <span class="builder-name">{{ prod.name }}</span>
            <p class="builder-desc">{{ prod.tagline }}{% if a.seatNote %} {{ a.seatNote }}{% endif %}</p>
            <span class="builder-users">
              <span class="builder-users-label" id="seats-label-{{ a.slug }}">{{ a.seatLabel }}</span>
              <span class="builder-stepper">
                <button type="button" data-seats-for="{{ a.slug }}" data-dir="-1" aria-label="Fewer {{ prod.name }} {{ a.seats }}">&minus;</button>
                <output class="builder-stepper-count" id="seats-{{ a.slug }}" aria-labelledby="seats-label-{{ a.slug }}" aria-live="polite">{{ a.includedSeats }}</output>
                <button type="button" data-seats-for="{{ a.slug }}" data-dir="1" aria-label="More {{ prod.name }} {{ a.seats }}">+</button>
              </span>
              <span class="builder-users-hint" id="hint-{{ a.slug }}">{{ a.includedSeats }} included &middot; {{ a.seatMonthly | usd }}/{{ a.seat }}/mo after</span>
            </span>
          </span>
          <span class="builder-price" id="price-{{ a.slug }}">+{{ a.monthly | usd }}/mo</span>
        </label>
        {% endfor %}

        <div class="builder-note" id="builder-note" aria-live="polite">
          <i class="ph-fill ph-check" id="builder-note-icon" aria-hidden="true"></i>
          <span id="builder-note-text">All three apps added. The platform fee is waived.</span>
        </div>

        <div class="builder-total">
          <span class="builder-total-label">Your Package</span>
          <span class="tier-price-row" aria-live="polite">
            <span class="tier-dollar">$</span>
            <span class="tier-price" id="builder-total">{{ (pricing.apps | sum("monthly")) | usd | replace("$", "") }}</span>
            <span class="tier-per" id="builder-per">/mo</span>
          </span>
        </div>

        <a class="ks-btn ks-btn-primary ks-btn-lg tier-cta" href="{{ site.demoUrl }}">Book a Demo</a>
        <ul class="tier-list">
          <li><i class="ph-fill ph-check" aria-hidden="true"></i><span>We set up your account and connect your tools with you on the demo</span></li>
          <li><i class="ph-fill ph-check" aria-hidden="true"></i><span>Owners can add apps and seats later from Billing</span></li>
          <li><i class="ph-fill ph-check" aria-hidden="true"></i><span>Up to {{ pricing.seatCap }} seats per app. Need more? Talk to us.</span></li>
        </ul>
      </div>

      <div class="tier reveal" id="custom">
        <div class="tier-tag">FRANCHISES AND MULTI-LOCATION</div>
        <div class="tier-name">Custom</div>
        <div class="tier-price-row">
          <span class="tier-price tier-price-text">Let&rsquo;s Talk</span>
        </div>
        <a class="ks-btn ks-btn-secondary ks-btn-lg tier-cta" href="{{ site.salesUrl }}">Talk to Sales</a>
        <ul class="tier-list">
          <li><i class="ph-fill ph-check" aria-hidden="true"></i><span>Several locations or franchisees on one plan</span></li>
          <li><i class="ph-fill ph-check" aria-hidden="true"></i><span>More than {{ pricing.seatCap }} seats on an app</span></li>
          <li><i class="ph-fill ph-check" aria-hidden="true"></i><span>A rollout plan we build with you</span></li>
        </ul>
      </div>

    </div>
  </div>
</section>

<section id="price-list" class="section section-surface">
  <div class="container">
    <div class="section-head reveal-group">
      <div class="ks-eyebrow reveal">PRICE LIST</div>
      <h2 class="ks-h1 reveal">Every Price in One Table</h2>
      <p class="ks-lede reveal">Annual plans cost ten times the monthly price, so you get two months free.</p>
    </div>
    <div class="price-list reveal">
      <table>
        <thead>
          <tr>
            <th scope="col">Item</th>
            <th scope="col">Monthly</th>
            <th scope="col">Annual</th>
            <th scope="col">Included</th>
            <th scope="col">Each Extra Seat</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <th scope="row"><span class="price-list-mark" style="background: var(--red-500)"><i class="ph-fill ph-database" aria-hidden="true"></i></span>{{ pricing.platform.name }}</th>
            <td data-label="Monthly">{{ pricing.platform.monthly | usd }}</td>
            <td data-label="Annual">{{ pricing.platform.annual | usd }}</td>
            <td data-label="Included" colspan="2">{{ pricing.platform.waiver }}</td>
          </tr>
          {% for a in pricing.apps %}
          {%- set prod = products[a.slug] %}
          <tr>
            <th scope="row"><a href="{{ prod.url }}"><span class="price-list-mark" style="background: {{ prod.color }}"><i class="{{ prod.icon }}" aria-hidden="true"></i></span>{{ prod.name }}</a></th>
            <td data-label="Monthly">{{ a.monthly | usd }}</td>
            <td data-label="Annual">{{ a.annual | usd }}</td>
            <td data-label="Included">{{ a.includedSeats }} {{ a.seat if a.includedSeats == 1 else a.seats }}</td>
            <td data-label="Each Extra Seat">{{ a.seatMonthly | usd }}/mo or {{ a.seatAnnual | usd }}/yr per {{ a.seat }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
      <ul class="price-list-rules">
        <li>{{ pricing.platform.waiver }}.</li>
        {% for a in pricing.apps %}{% if a.seatNote %}<li>{{ products[a.slug].name }}: {{ a.seatNote }}</li>{% endif %}{% endfor %}
        <li>Owners take a seat in Costing and Follow-Up.</li>
        <li>You can buy up to {{ pricing.seatCap }} seats per app. Beyond that, <a href="{{ site.salesUrl }}">talk to sales</a>.</li>
      </ul>
    </div>
  </div>
</section>
