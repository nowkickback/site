{% set demoUrl = site.demoUrl %}
<footer class="kb-footer" style="padding:var(--space-14) 0 var(--space-10);border-top:1px solid var(--border-subtle);background:var(--bg-surface)">
<div class="kb-container" style="display:flex;flex-wrap:wrap;gap:var(--space-8);justify-content:space-between;align-items:flex-start">
<div style="display:flex;flex-direction:column;gap:var(--space-3);max-width:280px">
<img data-logo="1" src="/assets/wordmark-on-light.svg" alt="Kickback" style="height:28px;align-self:flex-start">
<p style="font-size:13.5px;color:var(--fg-2);margin:0;line-height:1.55">AI for the back office of home-services businesses. Founded by owners, in Richmond, VA.</p>
{% if site.socialLinks and site.socialLinks.length %}
<div class="kb-socials" role="navigation" aria-label="Social links">
{% for link in site.socialLinks %}
<a class="kb-social" href="{{ link.href }}" target="_blank" rel="noopener noreferrer" aria-label="{{ link.label }}"><i class="ph {{ link.icon }}" aria-hidden="true"></i></a>
{% endfor %}
</div>
{% endif %}
</div>
<div style="display:flex;gap:var(--space-14);flex-wrap:wrap">
<div style="display:flex;flex-direction:column;gap:var(--space-2)">
<span style="font-family:var(--font-mono);font-size:10px;letter-spacing:0.08em;text-transform:uppercase;color:var(--fg-3)">Platform</span>
<a class="kb-footer-link" href="/costing/">Costing</a>
<a class="kb-footer-link" href="/follow-up/">Follow-Up</a>
</div>
<div style="display:flex;flex-direction:column;gap:var(--space-2)">
<span style="font-family:var(--font-mono);font-size:10px;letter-spacing:0.08em;text-transform:uppercase;color:var(--fg-3)">Company</span>
<a class="kb-footer-link" href="/about/">About</a>
<a class="kb-footer-link" href="/#pricing">Pricing</a>
<a class="kb-footer-link" href="/#faq">FAQ</a>
<a class="kb-footer-link" href="{{ demoUrl }}">Book a Demo</a>
</div>
</div>
</div>
<div class="kb-container" style="margin-top:var(--space-8);padding-top:var(--space-5);border-top:1px solid var(--border-subtle);display:flex;flex-wrap:wrap;gap:var(--space-3);justify-content:space-between;align-items:center;font-family:var(--font-mono);font-size:10.5px;letter-spacing:0.04em;color:var(--fg-3);text-transform:uppercase">
<span style="display:inline-flex;align-items:center;gap:var(--space-4);flex-wrap:wrap">
<span style="display:inline-flex;align-items:center;gap:5px"><i class="ph ph-copyright" aria-hidden="true"></i> 2026 Kickback, LLC</span>
<span style="display:inline-flex;align-items:center;gap:5px">Made with <i class="ph-fill ph-heart" style="color:var(--fg-brand)"></i> in Richmond, VA</span>
</span>
<span style="display:inline-flex;align-items:center;gap:var(--space-2);flex-wrap:wrap">
<a class="kb-footer-legal" href="/terms/">Terms</a>
<a class="kb-footer-legal" href="/privacy/">Privacy</a>
</span>
</div>
</footer>
