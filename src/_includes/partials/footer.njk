<footer class="site-footer">
  <div class="site-footer-inner">
    <div class="site-footer-top">
      <div>
        <img src="/assets/wordmark-on-dark.svg" alt="kickback">
        <p class="site-footer-tag">{{ site.footerTagline }}</p>
      </div>
      <div>
        <span class="ks-eyebrow">Platform</span>
        <ul>
          {% for p in productList %}
          <li>
            <a href="{{ p.url }}">{{ p.name }}</a>
            {% if p.status == "preview" %}
            <span style="color:var(--stone-500)">&mdash; preview</span>
            {% elif p.status == "soon" %}
            <span style="color:var(--stone-500)">&mdash; soon</span>
            {% endif %}
          </li>
          {% endfor %}
        </ul>
      </div>
      <div>
        <span class="ks-eyebrow">Integrations</span>
        <ul>
          {% for name in site.integrations %}
          <li>{{ name }}</li>
          {% endfor %}
        </ul>
      </div>
      <div>
        <span class="ks-eyebrow">Company</span>
        <ul>
          {% for link in site.companyLinks %}
          <li><a href="{{ link.href }}">{{ link.label }}</a></li>
          {% endfor %}
        </ul>
      </div>
      <div>
        <span class="ks-eyebrow">Resources</span>
        <ul>
          {% for link in site.resourceLinks %}
          <li><a href="{{ link.href }}">{{ link.label }}</a></li>
          {% endfor %}
        </ul>
      </div>
    </div>
    <div class="site-footer-bottom">
      <div class="site-footer-credit">
        <span>&copy; 2026 Kickback, LLC</span>
        <span class="site-footer-made">Made with <i class="ph-fill ph-heart" aria-hidden="true"></i> in Richmond, VA</span>
      </div>
      <div class="links">
        <a href="/privacy/">Privacy</a>
        <span>Terms</span>
        <a class="site-footer-status" href="{{ site.statusUrl }}" target="_blank" rel="noopener noreferrer" aria-label="System status">
          <img src="{{ site.statusBadge }}" alt="System status" loading="lazy">
        </a>
      </div>
    </div>
  </div>
</footer>
