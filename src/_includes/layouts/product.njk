---
layout: layouts/base.njk
---
{#- Product pages render from src/_data/products/<slug>.json in one standard order:
    hero, works-with, steps (#how), capabilities, automation, other-apps, faq,
    pricing-line (#pricing), cta (#demo). Each section's `type` names its template
    in sections/; an unknown type fails the build. -#}
{% set product = products[productKey] %}
{% set hero = product.hero %}
{% include "sections/hero.njk" %}

{% for section in product.sections %}
  {% include "sections/" + ("cta-banner" if section.type == "cta" else section.type) + ".njk" %}
{% endfor %}

{{ content | safe }}
