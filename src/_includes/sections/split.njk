{# Copy on one side, a hand-built mockup (`shot`, a partial in shots/) on the other. #}
{% set s = section %}
<section class="section {{ s.surface or 'section-surface' }}"{% if s.id %} id="{{ s.id }}"{% endif %}>
  <div class="container">
    <div class="split{% if s.reversed %} split-reversed{% endif %}">
      <div class="split-copy reveal-group">
        {% if s.eyebrow %}<div class="ks-eyebrow split-eyebrow reveal">{{ s.eyebrow }}</div>{% endif %}
        <h2 class="ks-h1 split-title reveal">{{ s.title }}</h2>
        {% if s.bodyHtml %}
        <p class="split-body reveal">{{ s.bodyHtml | safe }}</p>
        {% elif s.body %}
        <p class="split-body reveal">{{ s.body }}</p>
        {% endif %}
        {% if s.bullets %}
        <ul class="split-list reveal">
          {% for b in s.bullets %}
          <li>
            <i class="{{ b.icon or 'ph-fill ph-check' }}" aria-hidden="true"></i>
            <span><strong class="split-list-title">{{ b.title }}</strong>{{ b.text }}</span>
          </li>
          {% endfor %}
        </ul>
        {% endif %}
        {% if s.cta %}
        <a class="split-cta reveal" href="{{ s.cta.href }}">{{ s.cta.label }}</a>
        {% endif %}
      </div>
      {% if s.shot %}
      <div class="split-visual reveal">
        {% include "shots/" + s.shot + ".njk" %}
      </div>
      {% endif %}
    </div>
  </div>
</section>
