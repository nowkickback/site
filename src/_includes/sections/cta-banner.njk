{# Closing call to action. Copy comes from the section (or `cta` when included
   directly); the buttons are the same everywhere: Book a Demo, then See Pricing. #}
{% set cta = section if (section and section.type == "cta") else cta %}
<section class="section section-sm" id="{{ cta.id or 'demo' }}">
  <div class="container">
    <div class="cta-banner reveal-group">
      <div class="cta-banner-copy">
        {% if cta.kicker %}<div class="cta-banner-kicker reveal">{{ cta.kicker }}</div>{% endif %}
        <h2 class="reveal">{{ cta.title }}</h2>
        {% if cta.body %}<p class="reveal">{{ cta.body }}</p>{% endif %}
      </div>
      <div class="cta-banner-actions reveal">
        <a class="ks-btn ks-btn-primary ks-btn-lg" href="{{ site.demoUrl }}">Book a Demo</a>
        {% set secondary = cta.secondary or { label: "See Pricing", href: "/pricing/" } %}
        <a class="ks-btn ks-btn-secondary" href="{{ secondary.href }}">{{ secondary.label }}</a>
      </div>
    </div>
  </div>
</section>
