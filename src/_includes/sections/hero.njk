{# Page hero. Expects `hero`: { headlineHtml, lede|ledeHtml, ctas?, metaHtml?, shot? }.
   Without ctas it shows the standard pair: Book a Demo, then See How It Works. #}
{% set h = hero %}
{% set ctas = h.ctas or [
  { label: "Book a Demo", href: site.demoUrl, style: "primary" },
  { label: "See How It Works ↓", href: "#how", style: "secondary" }
] %}
<section class="hero hero-{{ h.variant or 'product' }}" id="top">
  <div class="ks-dotgrid hero-bg" aria-hidden="true"></div>
  <div class="container hero-inner reveal-group">
    {% if h.eyebrow %}<div class="ks-eyebrow hero-eyebrow reveal">{{ h.eyebrow }}</div>{% endif %}

    <h1 class="hero-headline reveal">{{ h.headlineHtml | safe }}</h1>

    {% if h.ledeHtml %}
    <p class="hero-lede reveal">{{ h.ledeHtml | safe }}</p>
    {% elif h.lede %}
    <p class="hero-lede reveal">{{ h.lede }}</p>
    {% endif %}

    <div class="hero-ctas reveal">
      {% for cta in ctas %}
      <a class="ks-btn ks-btn-{{ cta.style or 'primary' }} ks-btn-lg" href="{{ cta.href }}">{{ cta.label }}</a>
      {% endfor %}
    </div>

    {% if h.metaHtml %}
    <div class="hero-meta reveal">{{ h.metaHtml | safe }}</div>
    {% endif %}

    {% if h.shot %}
      {% include "shots/" + h.shot + ".njk" %}
    {% endif %}
  </div>
</section>
