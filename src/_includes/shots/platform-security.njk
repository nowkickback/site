<div class="pf-security" role="img" aria-label="Password and Security settings with a saved MacBook passkey, Google connected for sign-in, and the authenticator app turned on with 5 backup codes left">
  <div aria-hidden="true">
    <div class="pf-card">
      <div class="pf-card-head"><div class="pf-card-title">Passkeys</div></div>
      <div class="pf-card-body">
        <p class="pf-text">Sign in with Touch ID, Face ID, Windows Hello or your device PIN instead of your password. A passkey sign-in never asks for an authenticator code.</p>
        <div class="pf-list-row">
          <div class="pf-list-meta">
            <div class="pf-list-name"><i class="ph ph-fingerprint pf-glyph"></i>MacBook Pro</div>
            <div class="pf-help">Added October 2, 2026</div>
          </div>
          <span class="pf-btn">Remove</span>
        </div>
      </div>
    </div>

    <div class="pf-card">
      <div class="pf-card-head"><div class="pf-card-title">Connected Sign-In</div></div>
      <div class="pf-card-body">
        <div class="pf-list-row">
          <div class="pf-list-meta">
            <div class="pf-list-name"><i class="ph ph-google-logo pf-glyph"></i>Google</div>
            <div class="pf-help">dana@example.com</div>
          </div>
          <span class="pf-btn">Disconnect</span>
        </div>
        <div class="pf-list-row">
          <div class="pf-list-meta">
            <div class="pf-list-name"><i class="ph ph-windows-logo pf-glyph"></i>Microsoft</div>
            <div class="pf-help">Not connected</div>
          </div>
          <span class="pf-btn pf-btn-primary">Connect</span>
        </div>
        <div class="pf-list-row">
          <div class="pf-list-meta">
            <div class="pf-list-name"><i class="ph ph-apple-logo pf-glyph"></i>Apple</div>
            <div class="pf-help">Not connected</div>
          </div>
          <span class="pf-btn pf-btn-primary">Connect</span>
        </div>
      </div>
    </div>

    <div class="pf-card">
      <div class="pf-card-head">
        <div class="pf-card-title">Authenticator App</div>
        <span class="pf-badge pf-badge-on">On</span>
      </div>
      <div class="pf-card-body">
        <p class="pf-text">Signing in with your password also asks for a code from your authenticator app. 5 backup codes left.</p>
        <div class="pf-actions">
          <span class="pf-btn">New Backup Codes</span>
          <span class="pf-btn pf-btn-danger">Turn Off</span>
        </div>
      </div>
    </div>
  </div>
</div>
